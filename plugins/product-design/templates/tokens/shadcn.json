  "color": {
    "$type": "color",
    "$description": "色の役割。",
    "$extensions": {
      "com.github.japan-da-man.product-design": {
        "from": [
          "D1",
          "D2"
        ]
      }
    },
    "background": {
      "$value": "{primitive.color.background.light}",
      "$description": "画面の背景",
      "$extensions": {
        "com.github.japan-da-man.product-design": {
          "modes": {
            "dark": "{primitive.color.background.dark}"
          }
        }
      }
    },
    "foreground": {
      "$value": "{primitive.color.foreground.light}",
      "$description": "本文と見出しの文字",
      "$extensions": {
        "com.github.japan-da-man.product-design": {
          "modes": {
            "dark": "{primitive.color.foreground.dark}"
          }
        }
      }
    },
    "card": {
      "$value": "{primitive.color.card.light}",
      "$description": "カードの面",
      "$extensions": {
        "com.github.japan-da-man.product-design": {
          "modes": {
            "dark": "{primitive.color.card.dark}"
          }
        }
      }
    },
    "card-foreground": {
      "$value": "{primitive.color.card-foreground.light}",
      "$description": "カードの上の文字",
      "$extensions": {
        "com.github.japan-da-man.product-design": {
