        ]
      }
    },
    "large-title": {
      "$value": {
        "fontFamily": "{primitive.font-family.system}",
        "fontSize": {
          "value": 34,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.206,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "いちばん大きい見出し（画面の最初の見出し）",
      "$extensions": {
        "com.github.japan-da-man.product-design": {
          "textStyle": "large-title"
        }
      }
    },
