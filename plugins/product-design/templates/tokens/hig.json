        "com.github.japan-da-man.product-design": {
          "modes": {
            "dark": "{primitive.color.separator.dark}"
          },
          "swiftui": {
            "system": "separator"
          }
        }
      }
    },
    "fill": {
      "$value": "{primitive.color.fill.light}",
      "$description": "小さな部品の塗り（オン・オフの下地など）",
      "$extensions": {
        "com.github.japan-da-man.product-design": {
          "modes": {
            "dark": "{primitive.color.fill.dark}"
          },
          "swiftui": {
            "system": "systemFill"
          }
        }
      }
    },
    "secondary-fill": {
      "$value": "{primitive.color.secondary-fill.light}",
      "$description": "gray のボタンの塗り",
      "$extensions": {
        "com.github.japan-da-man.product-design": {
          "modes": {
            "dark": "{primitive.color.secondary-fill.dark}"
          },
          "swiftui": {
            "system": "secondarySystemFill"
          }
        }
      }
    },
    "system-background": {
      "$value": "{primitive.color.system-background.light}",
      "$description": "ふつうの画面の背景",
