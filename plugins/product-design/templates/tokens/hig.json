  "color": {
    "$type": "color",
    "$description": "色の役割。",
    "$extensions": {
      "com.github.japan-da-man.product-design": {
        "from": [
          "D1",
          "D2"
        ]
      }
    },
    "tint": {
      "$value": "{primitive.color.tint.light}",
      "$description": "主なボタン、選ばれている状態、リンク",
      "$extensions": {
        "com.github.japan-da-man.product-design": {
          "modes": {
            "dark": "{primitive.color.tint.dark}"
          },
          "swiftui": {
            "system": "accentColor"
          }
        }
      }
    },
    "label": {
      "$value": "{primitive.color.label.light}",
      "$description": "本文と見出しの文字",
      "$extensions": {
        "com.github.japan-da-man.product-design": {
          "modes": {
            "dark": "{primitive.color.label.dark}"
          },
          "swiftui": {
            "system": "label"
          }
        }
      }
    },
    "secondary-label": {
      "$value": "{primitive.color.secondary-label.light}",
      "$description": "補足、空の状態の文字",
      "$extensions": {
        "com.github.japan-da-man.product-design": {
          "modes": {
            "dark": "{primitive.color.secondary-label.dark}"
          }
        }
      }
    },
    "tertiary-label": {
      "$value": "{primitive.color.tertiary-label.light}",
      "$description": "目立たせない文字（本文に使わない）",
      "$extensions": {
        "com.github.japan-da-man.product-design": {
          "modes": {
            "dark": "{primitive.color.tertiary-label.dark}"
          },
          "swiftui": {
            "system": "tertiaryLabel"
          }
        }
      }
    },
    "placeholder-text": {
      "$value": "{primitive.color.placeholder-text.light}",
      "$description": "入力欄のプレースホルダー（本文に使わない）",
      "$extensions": {
        "com.github.japan-da-man.product-design": {
          "modes": {
            "dark": "{primitive.color.placeholder-text.dark}"
          },
          "swiftui": {
            "system": "placeholderText"
          }
        }
      }
    },
    "separator": {
      "$value": "{primitive.color.separator.light}",
      "$description": "区切り線",
