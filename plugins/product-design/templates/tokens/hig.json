          }
        }
      }
    },
    "on-tint": {
      "$value": "{primitive.color.on-tint.light}",
      "$description": "tint の上に載せる文字",
      "$extensions": {
        "com.github.japan-da-man.product-design": {
          "modes": {
            "dark": "{primitive.color.on-tint.dark}"
