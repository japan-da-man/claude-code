{
  "description": "goal-build: while a flow is active (.goal-build/active exists), block gh pr create / merge and edits to the approved SPEC.md, refuse to end a turn until .goal-build/check.sh passes, and inject the flow state at session start. Every hook does nothing when no flow is active.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-pr.sh\"", "timeout": 15, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-spec.sh\"", "timeout": 15, "onFailure": "block" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/run-checks.sh\"", "timeout": 600 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session-context.sh\"", "timeout": 15 }
        ]
      }
    ]
  }
}
