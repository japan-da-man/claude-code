{
  "description": "self-improve: load trial rules at session start, log failure signals, guard forbidden operations and harness files, and run verification, episode notes and the improvement-candidate check at the end of a turn. Runs in every git repository; every hook does nothing outside git repositories, in paths listed in exclude of ~/.claude/self-improve/config.json, or when HARNESS_DISABLE=1. Verification commands in harness/config.json run only after a person allows that exact content (harness-note verify trust).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs\"", "timeout": 30 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/log-event.mjs\"", "async": true }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/log-event.mjs\"", "async": true }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/log-event.mjs\"", "async": true }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-harness.mjs\"", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/on-stop.mjs\"", "timeout": 900 }
        ]
      }
    ]
  }
}
