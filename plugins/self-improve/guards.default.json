{
  "description": "どのリポジトリでも止めたい操作（共通リスト）。リポジトリ固有の禁止操作は、適用先の harness/guards.json に書く。ここのルールを外したいリポジトリは、harness/guards.json の disable_defaults に id を書く。decision が ask のルールは、拒否ではなく確認を挟む。テストケースは guards.default.test.json。",
  "rules": [
    {
      "id": "git-force-push",
      "pattern": "\\bgit(?:\\s+(?:-[cC]\\s+\\S+|--?[\\w-]+(?:=\\S+)?))*\\s+push\\b.*(?:\\s--force(?![\\w-])|\\s-[a-zA-Z]*f[a-zA-Z]*(?:\\s|$)|\\s\\+[^\\s]+)",
      "message": "git push --force（-f、+refspec）は止めています。リモートの履歴を上書きするためです。必要なら --force-with-lease を使うか、人に実行を頼んでください。"
    },
    {
      "id": "git-no-verify",
      "pattern": [
        "\\bgit(?:\\s+(?:-[cC]\\s+\\S+|--?[\\w-]+(?:=\\S+)?))*\\s+(?:push|merge|rebase|am|cherry-pick)\\b.*\\s--no-verify(?:\\s|$)",
        "\\bgit(?:\\s+(?:-[cC]\\s+\\S+|--?[\\w-]+(?:=\\S+)?))*\\s+commit\\b(?:\\s+(?:-[a-zA-Z]*m\\s+\\S+|--message(?:=\\S+|\\s+\\S+)|(?!--no-verify(?:\\s|$))(?!-[a-zA-Z]*m(?:\\s|$))(?!--message(?:\\s|$))\\S+))*\\s+--no-verify(?:\\s|$)",
        "\\bgit(?:\\s+(?:-[cC]\\s+\\S+|--?[\\w-]+(?:=\\S+)?))*\\s+commit\\b(?:\\s+(?:-[a-zA-Z]*m\\s+\\S+|--message(?:=\\S+|\\s+\\S+)|(?!-[aepsvqiozm]*n[aepsvqiozm]*(?:\\s|$))(?!-[a-zA-Z]*m(?:\\s|$))(?!--message(?:\\s|$))\\S+))*\\s+-[aepsvqiozm]*n[aepsvqiozm]*(?:\\s|$)"
      ],
      "message": "コミットやプッシュのフックを飛ばす --no-verify（git commit の -n）は止めています。フックが落ちる原因を直してください。どうしても必要なら、人に実行を頼んでください。"
    },
    {
      "id": "env-file-write",
      "decision": "ask",
      "flags": "i",
      "path": "(?:^|/)\\.env(?:\\.(?:local|development|dev|test|testing|staging|stage|production|prod|preview|ci|docker)(?:\\.local)?)?$",
      "message": ".env は秘密の値を持つファイルです。書き換える内容を確かめてください。変数を足すだけなら、.env.example に名前だけを書くほうが安全です"
    },
    {
      "id": "rm-root-or-home",
      "pattern": "\\brm\\s(?=(?:.*\\s)?(?:-[a-zA-Z]*[rR][a-zA-Z]*|--recursive)(?:\\s|$))(?:.*\\s)?(?:--\\s+)?(?:/|~/?|\\$HOME/?|\\$\\{HOME\\}/?|/\\*|~/\\*|\\$HOME/\\*)(?:\\s|$)",
      "message": "ルートやホームを丸ごと消す rm -r は止めています。消したいディレクトリを、具体的なパスで指定してください。"
    }
  ]
}
